# Supabase project — get these from the project's API settings page
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Postgres connection string for Drizzle migrations and runtime queries.
# Use the pooled connection string from Supabase ("Transaction" mode).
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# PII master encryption key (AES-256-GCM, 32 bytes base64-encoded).
# Generate locally with: openssl rand -base64 32
# This key encrypts all PII at rest. If it leaks, all PII is decryptable.
# If it's lost, all PII is unrecoverable. Save in a password manager and
# paste the same value into Vercel env vars.
PII_MASTER_KEY=

# MapTiler — single key used for both vector tiles (browser) and geocoding (server)
NEXT_PUBLIC_MAPTILER_KEY=
MAPTILER_GEOCODE_KEY=

# Gmail SMTP — dedicated account with 2FA + App Password
GMAIL_SMTP_USER=sa.bibletalks@gmail.com
GMAIL_SMTP_APP_PASSWORD=

# Cloudflare Turnstile — site key in browser, secret on server
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET=

# Backblaze B2 — used by the weekly backup workflow only
BACKBLAZE_B2_KEY_ID=
BACKBLAZE_B2_APP_KEY=
BACKBLAZE_B2_BUCKET=sa-bible-talks-backups
